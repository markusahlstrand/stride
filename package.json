{
  "name": "stride",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n issuer,api,web -c yellow,blue,magenta \"pnpm issuer\" \"STRIDE_DEV_AUTH=1 tsx watch src/server.ts\" \"pnpm --filter stride-app dev\"",
    "server": "STRIDE_DEV_AUTH=1 tsx src/server.ts",
    "app:dev": "pnpm --filter stride-app dev",
    "app:build": "pnpm --filter stride-app build",
    "changeset": "changeset",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm --filter stride-app exec tsc -b",
    "lint:boundaries": "substrat-boundary-lint",
    "lint:model": "tsx tools/emit-model.mts",
    "deploy": "substrat push",
    "deploy:preview": "substrat preview create --empty --tag dev",
    "issuer": "tsx node_modules/@substrat-run/dev-issuer/dist/cli.js --personas src/personas.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@substrat-run/adapter-cloudflare": "^0.146.0",
    "@substrat-run/adapter-sqlite": "^0.146.0",
    "@substrat-run/contracts": "^0.146.0",
    "@substrat-run/engine-invites": "^0.9.23",
    "@substrat-run/engine-workorder": "^0.12.30",
    "@substrat-run/kernel": "^0.146.0",
    "@substrat-run/vertical-auth": "^0.24.1",
    "@substrat-run/vertical-host": "^0.146.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@substrat-run/boundary-lint": "^0.7.1",
    "@substrat-run/cli": "^0.42.0",
    "@substrat-run/dev-issuer": "^0.2.28",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "substrat": {
    "slug": "stride",
    "name": "Stride",
    "tenant": "t-5ra4yxscep",
    "runtimeNeeds": {
      "entry": "src/worker.ts",
      "needsNodeCompat": true,
      "build": "pnpm --filter stride-app build",
      "assets": {
        "directory": "app/dist",
        "notFoundHandling": "single-page-application",
        "runWorkerFirst": [
          "/api/*",
          "/internal/*"
        ]
      },
      "stores": [
        {
          "class": "ScopeDO",
          "binding": "SCOPE"
        },
        {
          "class": "IdentityDO",
          "binding": "IDENTITY"
        },
        {
          "class": "ConfigDO",
          "binding": "CONFIG"
        }
      ]
    },
    "permissions": "src/modules.ts",
    "requires": [
      "oidc-issuer"
    ],
    "envSpec": [
      {
        "key": "WITHINGS_CLIENT_ID",
        "label": "Withings client ID",
        "description": "From the Withings developer dashboard. Together with the secret, it turns on the Withings card on Progress.",
        "placeholder": "1782e150\u2026",
        "required": false,
        "secret": false,
        "group": "Withings"
      },
      {
        "key": "WITHINGS_CLIENT_SECRET",
        "label": "Withings client secret",
        "description": "Shown once when the Withings application is created. Write-only here.",
        "placeholder": "",
        "required": false,
        "secret": true,
        "group": "Withings"
      }
    ],
    "outbound": [
      "wbsapi.withings.net"
    ]
  }
}
