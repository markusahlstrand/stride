{
  "name": "stride",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n issuer,api,web -c yellow,blue,magenta \"pnpm issuer\" \"STRIDE_DEV_AUTH=1 tsx watch src/server.ts\" \"pnpm --filter stride-app dev\"",
    "server": "STRIDE_DEV_AUTH=1 tsx src/server.ts",
    "app:dev": "pnpm --filter stride-app dev",
    "app:build": "pnpm --filter stride-app build",
    "changeset": "changeset",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm --filter stride-app exec tsc -b",
    "lint:boundaries": "substrat-boundary-lint",
    "deploy": "substrat push",
    "deploy:preview": "substrat preview create --empty --tag dev",
    "issuer": "tsx node_modules/@substrat-run/dev-issuer/dist/cli.js --personas src/personas.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@substrat-run/adapter-cloudflare": "^0.114.0",
    "@substrat-run/adapter-sqlite": "^0.114.0",
    "@substrat-run/contracts": "^0.114.0",
    "@substrat-run/engine-invites": "^0.7.13",
    "@substrat-run/engine-workorder": "^0.11.13",
    "@substrat-run/kernel": "^0.114.0",
    "@substrat-run/vertical-auth": "^0.14.3",
    "@substrat-run/vertical-host": "^0.114.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cloudflare/workers-types": "^5.20260919.1",
    "@substrat-run/boundary-lint": "^0.4.2",
    "@substrat-run/cli": "^0.32.4",
    "@substrat-run/dev-issuer": "^0.1.29",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "substrat": {
    "slug": "stride",
    "name": "Stride",
    "tenant": "t-5ra4yxscep",
    "runtimeNeeds": {
      "entry": "src/worker.ts",
      "needsNodeCompat": true,
      "build": "pnpm --filter stride-app build",
      "assets": {
        "directory": "app/dist",
        "notFoundHandling": "single-page-application",
        "runWorkerFirst": [
          "/api/*",
          "/internal/*"
        ]
      },
      "stores": [
        {
          "class": "ScopeDO",
          "binding": "SCOPE"
        },
        {
          "class": "IdentityDO",
          "binding": "IDENTITY"
        },
        {
          "class": "ConfigDO",
          "binding": "CONFIG"
        }
      ]
    },
    "permissions": "src/modules.ts",
    "requires": [
      "oidc-issuer"
    ]
  }
}
